# konfig.env — nur die Schlüssel des Inventars; die des Kerns (ARBEITSORDNER, DB_URL, MANDANT_NAME, WEB_GEHEIMNIS, …)
# stehen in derselben Datei (Kern-konfig.env.beispiel). Auf der Box gibt es nur diese eine Datei.

# Basis-Adresse im QR-Code der Etiketten, z. B. https://box.firma.example — leer: aus der Anfrage ableiten.
# Muss mit http:// oder https:// beginnen, sonst bricht der Start mit einem Hinweis ab.
INVENTAR_ETIKETT_URL=
